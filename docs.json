{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Distrify",
  "colors": {
    "primary": "#16A34A",
    "light": "#07C983",
    "dark": "#15803D"
  },
  "favicon": "/favicon.png",
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Authentication",
            "pages": [
              "guides/login"
            ]
          },
          {
            "group": "Mobile app",
            "pages": [
              "guides/catalog",
              "guides/product-detail",
              "guides/cart-checkout",
              "guides/orders"
            ]
          }
        ]
      },
      {
        "tab": "API reference",
        "groups": [
          {
            "group": "API documentation",
            "pages": [
              "api-reference/introduction"
            ]
          },
          {
            "group": "Authentication",
            "pages": [
              "api-reference/authentication/list-organizations",
              "api-reference/authentication/set-default-organization"
            ]
          },
          {
            "group": "Organization",
            "pages": [
              "api-reference/organization/profile"
            ]
          },
          {
            "group": "Staff",
            "pages": [
              "api-reference/staff/profile",
              "api-reference/staff/permissions",
              "api-reference/staff/list",
              "api-reference/staff/get",
              "api-reference/staff/create",
              "api-reference/staff/update",
              "api-reference/staff/toggle-active",
              "api-reference/staff/delete"
            ]
          },
          {
            "group": "Products",
            "pages": [
              "api-reference/products/list",
              "api-reference/products/get",
              "api-reference/products/media",
              "api-reference/products/media-bulk",
              "api-reference/products/unit-of-measures",
              "api-reference/products/brands",
              "api-reference/products/categories",
              "api-reference/products/prices-bulk"
            ]
          },
          {
            "group": "Inventory",
            "pages": [
              "api-reference/inventory/warehouses",
              "api-reference/inventory/stock-bulk",
              "api-reference/inventory/stock-details",
              "api-reference/inventory/lots"
            ]
          },
          {
            "group": "Clients",
            "pages": [
              "api-reference/clients/list",
              "api-reference/clients/get",
              "api-reference/clients/addresses"
            ]
          },
          {
            "group": "Orders",
            "pages": [
              "api-reference/orders/list",
              "api-reference/orders/create",
              "api-reference/orders/get",
              "api-reference/orders/update",
              "api-reference/orders/change-status",
              "api-reference/orders/change-delivery-status",
              "api-reference/orders/timeline",
              "api-reference/orders/mark-invoiced",
              "api-reference/orders/void",
              "api-reference/orders/invoice-pdf",
              "api-reference/orders/order-payments",
              "api-reference/orders/create-payment",
              "api-reference/orders/charge-types",
              "api-reference/orders/delivery-statuses",
              "api-reference/orders/payment-methods",
              "api-reference/orders/payment-terms",
              "api-reference/orders/credit-memos",
              "api-reference/orders/credit-memo",
              "api-reference/orders/price-history"
            ]
          },
          {
            "group": "Search",
            "pages": [
              "api-reference/search/products",
              "api-reference/search/orders",
              "api-reference/search/order-counts"
            ]
          },
          {
            "group": "Purchases",
            "pages": [
              "api-reference/purchases/incoming-qty"
            ]
          },
          {
            "group": "Quotes",
            "pages": [
              "api-reference/quotes/quoted-qty"
            ]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/distrify-light.png",
    "dark": "/logo/distrify-dark.png"
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Sign in",
      "href": "https://jadix.distrify.us"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "_unused_reference_pages": {
    "description": "Sample/starter pages kept on disk as reference for future Mintlify components/patterns. Not registered in `navigation` so they won't render in the sidebar.",
    "pages": [
      "index",
      "quickstart",
      "development",
      "essentials/settings",
      "essentials/navigation",
      "essentials/markdown",
      "essentials/code",
      "essentials/images",
      "essentials/components",
      "essentials/reusable-snippets",
      "agent-ready/prompt",
      "agent-ready/visibility",
      "agent-ready/contextual",
      "ai-tools/cursor",
      "ai-tools/claude-code",
      "ai-tools/windsurf"
    ]
  }
}
