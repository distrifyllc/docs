{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Distrify",
  "colors": {
    "primary": "#16A34A",
    "light": "#07C983",
    "dark": "#15803D"
  },
  "favicon": "/favicon.png",
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Authentication",
            "pages": [
              "guides/login"
            ]
          }
        ]
      },
      {
        "tab": "API reference",
        "groups": [
          {
            "group": "API documentation",
            "pages": [
              "api-reference/introduction"
            ]
          },
          {
            "group": "Authentication",
            "pages": [
              "api-reference/authentication/list-organizations",
              "api-reference/authentication/set-default-organization"
            ]
          },
          {
            "group": "Organization",
            "pages": [
              "api-reference/organization/profile"
            ]
          },
          {
            "group": "Staff",
            "pages": [
              "api-reference/staff/profile",
              "api-reference/staff/permissions",
              "api-reference/staff/list",
              "api-reference/staff/get",
              "api-reference/staff/create",
              "api-reference/staff/update",
              "api-reference/staff/toggle-active",
              "api-reference/staff/delete"
            ]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/distrify-light.png",
    "dark": "/logo/distrify-dark.png"
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Sign in",
      "href": "https://jadix.distrify.us"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "_unused_reference_pages": {
    "description": "Sample/starter pages kept on disk as reference for future Mintlify components/patterns. Not registered in `navigation` so they won't render in the sidebar.",
    "pages": [
      "index",
      "quickstart",
      "development",
      "essentials/settings",
      "essentials/navigation",
      "essentials/markdown",
      "essentials/code",
      "essentials/images",
      "essentials/components",
      "essentials/reusable-snippets",
      "agent-ready/prompt",
      "agent-ready/visibility",
      "agent-ready/contextual",
      "ai-tools/cursor",
      "ai-tools/claude-code",
      "ai-tools/windsurf"
    ]
  }
}
